# Optional Supabase account sync (public client identifiers; protected by RLS).
# Leave empty to keep the collection local-only.
# TCG_SUPABASE_URL=https://your-project.supabase.co
# TCG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
TCG_SUPABASE_URL=
TCG_SUPABASE_PUBLISHABLE_KEY=

# Optional release signing. Leave empty for a debug-signed local build.
# TCG_KEYSTORE_PATH=/path/to/release.keystore
TCG_KEYSTORE_PATH=
TCG_KEYSTORE_PASSWORD=
TCG_KEY_ALIAS=
TCG_KEY_PASSWORD=

# Optional release metadata.
TCG_VERSION_CODE=1
TCG_VERSION_NAME=1.0.0
TCG_ALLOW_DEBUG_SIGNING=0

# Hosted sync verification accounts (never commit real values).
HOSTED_EMAIL_A=
HOSTED_PASSWORD_A=
HOSTED_EMAIL_B=
HOSTED_PASSWORD_B=
